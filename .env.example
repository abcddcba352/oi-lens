# Use demo until FYERS credentials are configured.
OI_PROVIDER=demo

# Long random server-only value used to encrypt the local FYERS cookies.
# When omitted in development, cookies safely expire after a server restart.
OI_COOKIE_SECRET=

# Interactive FYERS login. Keep Secret ID only in server-side environment settings.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://localhost:3000/api/auth/fyers/callback

# Optional fixed server token fallback. Interactive login does not need this.
FYERS_AUTH_TOKEN=
FYERS_API_BASE=https://api-t1.fyers.in

# Public deployment origin used for canonical social metadata.
SITE_URL=http://localhost:3000
