# Use demo until FYERS credentials are configured.
OI_PROVIDER=demo

# Set OI_PROVIDER=fyers and provide the complete Authorization header value
# issued by FYERS. Never expose this value in client-side code.
FYERS_AUTH_TOKEN=
FYERS_API_BASE=https://api-t1.fyers.in

# Public deployment origin used for canonical social metadata.
SITE_URL=http://localhost:3001
